# Copy to server/.env and fill in. server/.env is git-ignored.
DB_URL=jdbc:mysql://localhost:3306/portfoliopro
DB_USERNAME=portfoliopro
DB_PASSWORD=
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=120
# Free key from https://finnhub.io/dashboard
FINNHUB_API_KEY=
